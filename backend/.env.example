# Switch between "local" (LocalStack S3 + HTTP dev) and "prod" (Cloudflare R2 + HTTPS)
STORAGE_PROVIDER=local

# Server HTTP (dev) vs HTTPS (prod)
SERVER_PORT=8080
SERVER_SSL_ENABLED=false
# For prod HTTPS:
# SERVER_PORT=8443
# SERVER_SSL_ENABLED=true

# LocalStack S3 settings (used when STORAGE_PROVIDER=local)
LOCAL_S3_ENDPOINT=http://localhost:4566
LOCAL_S3_PUBLIC_ENDPOINT=http://localhost:4566
LOCAL_S3_REGION=us-east-1
LOCAL_S3_BUCKET=silkroad-local
LOCAL_S3_ACCESS_KEY=test
LOCAL_S3_SECRET_KEY=test

# Production Cloudflare R2 settings (used when STORAGE_PROVIDER=prod)
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=silkroad-r2
R2_ACCESS_KEY=<R2_ACCESS_KEY_ID>
R2_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
