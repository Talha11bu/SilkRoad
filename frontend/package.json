{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run index.html\" \"bun x tailwindcss -i ./src/index.css -o ./src/output.css --watch\"",
    "build": "bun x tailwindcss -i ./src/index.css -o ./src/output.css --minify && tsc -b && bun build ./index.html --outdir ./dist --minify --production",
    "lint": "eslint ."
  },
  "dependencies": {
    "@stomp/stompjs": "^7.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.5",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
